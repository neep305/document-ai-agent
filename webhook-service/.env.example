# Adobe Excel Service Configuration
# Copy this file to .env and update with your values

# Server Configuration
PORT=3000
NODE_ENV=development

# Python Command
# Windows: python  (Python 3 is usually invoked as 'python' on Windows)
# macOS/Linux: python3
PYTHON_CMD=python

# n8n Webhook Configuration — 3-Stage Split (v2.0)
# Each stage has its own webhook URL matching the workflow's path

# SDR Workflow: BRD Excel → SDR Excel (document_ai_SDR_v2.0.json)
N8N_SDR_WEBHOOK_URL=http://localhost:5678/webhook/sdr

# TSD Workflow: sdrData JSON → TSD files (document_ai_TSD_v2.0.json)
N8N_TSD_WEBHOOK_URL=http://localhost:5678/webhook/tsd

# Tags Workflow: sdrData JSON → Adobe Launch rules (document_ai_Tags_v2.0.json)
N8N_TAGS_WEBHOOK_URL=http://localhost:5678/webhook/tags

# Legacy fallback (if N8N_SDR_WEBHOOK_URL is not set, this is used)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/22ad9668-47fd-4d5c-9cf7-69d72aa838e1

#N8N API KEY (n8n에서 생성한 API Key 입력)
N8N_API_KEY=your_n8n_api_key_here

# n8n API Base URL — Stop/Cancel API 전용 (webhook URL과 별도)
# webhook-service가 Docker 컨테이너 안에서 실행될 때:
#   localhost:5678 은 컨테이너 자신 → ECONNREFUSED 발생
#   host.docker.internal:5678 로 설정해야 호스트의 n8n에 연결됨
# webhook-service가 호스트에서 직접 실행될 때: localhost:5678 사용
N8N_API_BASE_URL=http://host.docker.internal:5678

# Callback Host (n8n → webhook-service 역방향 호출 시 사용)
# n8n이 Docker 컨테이너에서 실행: host.docker.internal (Windows/Mac Docker Desktop)
# n8n이 호스트에서 직접 실행: localhost
CALLBACK_HOST=host.docker.internal

# Excel Sheet Names (must match template file)
# Defaults are set for the standard Adobe Analytics SDR template
SHEET_NAME_EVARS=eVars
SHEET_NAME_PROPS=props
SHEET_NAME_EVENTS=custom events (metrics)

# n8n API Key (실행 중인 워크플로우 강제 종료 시 사용)
# n8n Settings > API > Create API Key 에서 생성
# 비워두면 서버 job 상태만 cancelled로 변경되고 n8n execution은 계속 실행될 수 있음
N8N_API_KEY=

# ── Auto-chain: SDR 완료 후 TSD 자동 트리거 ──────────────────────────
# true: SDR 워크플로우 완료(status=completed) 수신 시 TSD 워크플로우를 자동으로 트리거
# false(기본): 수동으로 /trigger/tsd 를 호출해야 TSD 생성 시작
# 주의: N8N_TSD_WEBHOOK_URL이 설정돼 있어야 동작
AUTO_CHAIN_TSD=false

# n8n 로그인 정보 (execution 강제 중단 fallback 용)
# N8N_EMAIL=admin@example.com
# N8N_PASSWORD=your_n8n_password

# ── Google OAuth2 (Drive File Explorer) ──────────────────────────────────────
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Application type: Web application
# Authorized redirect URI: http://localhost:3000/auth/google/callback
# Required API: Google Drive API (enable in API Library)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# 세션 보안 키 (임의의 랜덤 문자열로 변경하세요)
SESSION_SECRET=change-me-to-random-string
