    {
      "parameters": {
        "jsCode": "const credentials = {\n  accessToken: $('Merge Token & Credentials').first().json.access_token,\n  apiKey: $('Merge Token & Credentials').first().json.credentials.API_KEY,\n  imgOrg: $('Merge Token & Credentials').first().json.credentials.IMS_ORG\n};\n\nreturn [{\n  json: Object.assign(credentials, JSON.parse($('Create Rule').first().json.data))\n}];"
