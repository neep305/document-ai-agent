    {
      "parameters": {
        "url": "=https://reactor.adobe.io/properties/{{ $json.credentials.PROPERTY_ID }}/extensions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.access_token }}"
            },
            {
              "name": "x-gw-ims-org-id",
              "value": "={{ $json.credentials.IMS_ORG }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.api+json;revision=1"
            },
            {
              "name": "x-api-key",
              "value": "={{ $json.credentials.API_KEY }}"
            }
          ]
