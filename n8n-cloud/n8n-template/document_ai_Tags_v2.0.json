        "options": {}
      },
      "id": "b063dd15-c1d2-4a1c-9258-0f802f1127a3",
      "name": "Get Existing Extensions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        32672,
        2688
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse extension info and prepare config\nconst input = $input.first().json[\"data\"];\nconst { data: arrInput } = JSON.parse(input);\nconst tokenData = $('Merge Token & Credentials').first().json;\n\nconst existingExtensions = (arrInput || []).map(ext => ({\n  id: ext.id,\n  name: ext.attributes?.name,\n  delegateDescriptorId: ext.attributes?.delegate_descriptor_id,\n  extensionPackage: ext.relationships.extension_package.data.id\n}));\n\nconst coreExt = existingExtensions.find(ext =>\n  ext.delegateDescriptorId?.includes('core::') || ext.name?.toLowerCase() === 'core'\n);\n\nconst alloyExt = existingExtensions.find(ext =>\n  ext.delegateDescriptorId?.includes('alloy') ||\n  ext.delegateDescriptorId?.includes('adobe-cloud-connector') ||\n  ext.name?.toLowerCase().includes('web sdk') ||\n  ext.name?.toLowerCase().includes('alloy')\n);\n\nreturn [{\n  json: {\n    accessToken: tokenData.access_token,\n    credentials: tokenData.credentials,\n    existingExtensions,\n    coreExtensionId: coreExt?.id,\n    alloyExtensionId: alloyExt?.id,\n    alloyInstalled: !!alloyExt\n  }\n}];"
      },
      "id": "9da87f1a-03ce-49fb-9766-9c670dc63fdc",
      "name": "Parse Extensions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        32896,
        2688
      ]
    },
    {
      "parameters": {
        "jsCode": "// Dynamically load rules from TSD Agent's launchPayload output\nconst input = $input.first().json;\n\nconst tsdData = $('Parse TSD Output').first().json;\nconst launchPayloadContent = tsdData.files?.launchPayload?.content;\n\nif (!launchPayloadContent) {\n  console.warn('⚠️  No launchPayload found in TSD output — skipping Adobe Launch deployment');\n  return [];\n}\n\nlet launchConfig;\ntry {\n  launchConfig = typeof launchPayloadContent === 'string'\n    ? JSON.parse(launchPayloadContent)\n    : launchPayloadContent;\n} catch (e) {\n  throw new Error('Failed to parse launchPayload JSON: ' + e.message);\n}\n\nconst rules = launchConfig.rules || [];\nif (rules.length === 0) {\n  console.warn('⚠️  launchPayload contains no rules');\n  return [];\n}\n\nconsole.log(`Preparing ${rules.length} rules from launchPayload for Adobe Launch deployment`);\n\nreturn rules.map((rule, idx) => ({\n  json: {\n    ...input,\n    ruleIndex: idx,\n    ruleName: rule.name,\n    ruleEvents: rule.events || [],\n    ruleConditions: rule.conditions || [],\n    ruleActions: rule.actions || [],\n    totalRules: rules.length\n  }\n}));"
      },
      "id": "92bda946-847a-4717-84cd-6a061ffa0c73",
      "name": "Prepare Rules (Dynamic)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        33120,
        2688
      ]
    },
    {
      "parameters": {
        "options": {
          "reset": false
        }
      },
      "id": "fb2eaae1-6ef3-4e6f-8fb4-3860c6d75bda",
      "name": "Loop Rules",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        33344,
        2688
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://reactor.adobe.io/properties/{{ $('Merge Token & Credentials').item.json.credentials.PROPERTY_ID }}/rules",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Merge Token & Credentials').item.json.access_token }}"
            },
            {
              "name": "x-api-key",
              "value": "={{ $('Merge Token & Credentials').item.json.credentials.API_KEY }}"
            },
            {
              "name": "x-gw-ims-org-id",
              "value": "={{ $('Merge Token & Credentials').item.json.credentials.IMS_ORG }}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.api+json;revision=1"
            },
            {
              "name": "Content-Type",
              "value": "application/vnd.api+json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"data\": {\n    \"type\": \"rules\",\n    \"attributes\": {\n      \"name\": \"{{ $json.ruleName }}\",\n      \"enabled\": true\n    }\n  }\n}",
        "options": {}
      },
      "id": "acf8ca62-89e6-4442-b87d-bf712643845c",
      "name": "Create Rule",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        33568,
        2688
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract rule ID and prepare rule components (Events, Conditions, Actions)\nconst ruleResult = $input.first().json;\nconst prevData = $('Loop Rules').first().json;\n\nconst ruleObj = JSON.parse(ruleResult.data);\nconst ruleId = ruleObj?.data.id;\n\nconst descriptorMapping = {\n  \"adobe-alloy/src/lib/actions/sendEvent.js\": \"adobe-alloy::actions::send-event\",\n  \"core/src/lib/events/click.js\": \"core::events::click\",\n  \"core/src/lib/events/libraryLoaded.js\": \"core::events::library-loaded\",\n  \"core/src/lib/events/domReady.js\": \"core::events::dom-ready\",\n  \"core/src/lib/conditions/customCode.js\": \"core::conditions::custom-code\"\n};\n\nif (!ruleId) {\n  throw new Error(`Rule creation failed (${prevData.ruleName}): ${JSON.stringify(ruleResult)}`);\n}\n\nconst components = [];\n\n// Events\n(prevData.ruleEvents || []).forEach((evt, idx) => {\n  components.push({\n    componentType: 'events',\n    order: idx,\n    modulePath: evt.modulePath,\n    extensionDescriptorId: descriptorMapping[evt.modulePath] || evt.modulePath,\n    extensionId: prevData.coreExtensionId,\n    settings: JSON.stringify(evt.settings || {}),\n    name: `Event ${idx + 1}`\n  });\n});\n\n// Conditions\n(prevData.ruleConditions || []).forEach((cond, idx) => {\n  components.push({\n    componentType: 'conditions',\n    order: idx,\n    modulePath: cond.modulePath,\n    extensionDescriptorId: descriptorMapping[cond.modulePath] || cond.modulePath,\n    extensionId: prevData.coreExtensionId,\n    settings: JSON.stringify(cond.settings || {}),\n    name: `Condition ${idx + 1}`,\n    negate: false\n  });\n});\n\n// Actions\n(prevData.ruleActions || []).forEach((act, idx) => {\n  const isAlloy = act.modulePath?.includes('alloy') || act.modulePath?.includes('adobe-alloy') || act.modulePath?.includes('adobe-alchemy');\n  components.push({\n    componentType: 'actions',\n    order: idx,\n    modulePath: act.modulePath,\n    extensionDescriptorId: descriptorMapping[act.modulePath] || act.modulePath,\n    extensionId: isAlloy ? prevData.alloyExtensionId : prevData.coreExtensionId,\n    settings: JSON.stringify(act.settings || {}),\n    name: `Action ${idx + 1}`\n  });\n});\n\nreturn components.map(comp => ({\n  json: { ...prevData, ruleId, component: comp }\n}));"
      },
      "id": "bf6d6474-d1d7-4262-a09e-f89ea37bde4f",
