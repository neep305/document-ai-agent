# webhook-service-m365 — Adobe Excel Service + Microsoft Graph upload
# Copy this file to .env and update with your values

# ── Server Configuration ────────────────────────────────────────────────────
# Default 3001 (webhook-service 원본은 3000)
PORT=3001
# development | production
NODE_ENV=development

# Python Command
# Windows: python  (Python 3 is usually invoked as 'python' on Windows)
# macOS/Linux: python3
PYTHON_CMD=python

# ── n8n Webhook URLs ─────────────────────────────────────────────────────────
# Each stage has its own webhook URL matching the workflow's trigger path.
# Use /webhook/ for production (Active workflow) or /webhook-test/ for test mode.
#
# [Local]   http://localhost:5678/webhook/sdr
# [Docker]  http://host.docker.internal:5678/webhook/sdr
# [Railway → Lightsail n8n]  http://<LIGHTSAIL_IP>:5678/webhook/sdr
#           Make sure port 5678 is open in Lightsail firewall for Railway egress IPs.

# SDR Workflow: BRD Excel → SDR Excel (document_ai_SDR_v2.0.json)
N8N_SDR_WEBHOOK_URL=http://localhost:5678/webhook/sdr

# TSD Workflow: sdrData JSON → TSD files (document_ai_TSD_v2.5.json)
N8N_TSD_WEBHOOK_URL=http://localhost:5678/webhook/tsd

# Tags Workflow: sdrData JSON → Adobe Launch rules (document_ai_Tags_v2.0.json)
N8N_TAGS_WEBHOOK_URL=http://localhost:5678/webhook/tags

# Legacy fallback (used only when N8N_SDR_WEBHOOK_URL is not set)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/22ad9668-47fd-4d5c-9cf7-69d72aa838e1

# ── n8n API (Stop/Cancel executions) ─────────────────────────────────────────
# n8n Settings > API > Create API Key
# Note: API keys expire — regenerate before expiry and update here.
N8N_API_KEY=your_n8n_api_key_here

# n8n API Base URL — separate from webhook URLs, used for management API calls
# [Local]               http://localhost:5678
# [Docker container]    http://host.docker.internal:5678
# [Railway → Lightsail] http://<LIGHTSAIL_IP>:5678
N8N_API_BASE_URL=http://localhost:5678

# n8n login credentials — fallback for session-cookie auth if API key doesn't work
# N8N_EMAIL=admin@example.com
# N8N_PASSWORD=your_n8n_password

# ── Callback Host ─────────────────────────────────────────────────────────────
# Address that n8n uses to call back into webhook-service (POST /webhook/sdr-result).
# Must be reachable FROM n8n's network.
#
# [Local / Docker Desktop]  host.docker.internal
# [Direct host execution]   localhost
# [Railway deployment]      your-app.railway.app   ← no https:// prefix, no trailing slash
#
# If this is wrong, jobs will hang in "processing" state indefinitely.
CALLBACK_HOST=host.docker.internal

# ── Excel Sheet Names ─────────────────────────────────────────────────────────
# Must match sheet tab names in the SDR Excel template
SHEET_NAME_EVARS=eVars
SHEET_NAME_PROPS=props
SHEET_NAME_EVENTS=custom events (metrics)

# ── Auto-chain ────────────────────────────────────────────────────────────────
# true: automatically trigger TSD workflow after SDR completes
# false (default): manually call /trigger/tsd
AUTO_CHAIN_TSD=false

# ── Google OAuth2 (Drive File Explorer) ──────────────────────────────────────
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Application type: Web application
# Required API: Google Drive API (enable in API Library)
#
# Authorized redirect URIs to register in Google Cloud Console:
#   [Local]   http://localhost:3001/auth/google/callback
#   [Railway] https://your-app.railway.app/auth/google/callback
#
# GOOGLE_REDIRECT_URI must match the redirect URI in Google Cloud Console exactly
# (same string in Railway env vars and in Console). If only Console is updated,
# token exchange on the server will fail.
#
# Also add Authorized JavaScript origins (no path): e.g. https://your-app.railway.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# ── Session ───────────────────────────────────────────────────────────────────
# Change to a random string in production
SESSION_SECRET=change-me-to-random-string

# ── Microsoft 365 / Graph (POST /v1/upload) ───────────────────────────────────
M365_SERVICE_API_KEY=change-me-long-random
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_SITE_PATH=contoso.sharepoint.com:/sites/YourTeamSite
# GRAPH_SITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GRAPH_DEFAULT_FOLDER=DocumentAI
MAX_UPLOAD_MB=50
GRAPH_UPLOAD_SESSION_THRESHOLD_MB=4
LOG_UPLOADS=false
