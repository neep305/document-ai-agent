    {
      "name": "Page View - Home/PLP",
      "notes": "Generated from JS adobeDataLayer.push({event: 'page-view', pageType: 'home'/'product-list'})",
      "events": [
        {
          "delegate_id": "adobe-launch-extension-core:event-data-element-change",
          "extension_name": "core",
          "settings": {
            "path": "event",
            "condition": "%event.message.event% === 'page-view' && (%event.message.pageType% === 'home' || %event.message.pageType% === 'product-list')"
          }
        }
      ],
      "actions": [
        {
          "delegate_id": "adobe-alchemy:action-send-event",
          "extension_name": "adobe-alchemy",
          "settings": {
            "xdm": {
              "eventType": "web.webPageDetails.pageViews",
              "web": {
                "webPageDetails": {
                  "pageViews": {
                    "value": 1
                  },
                  "name": "%event.message.web.webPageDetails.name%",
                  "siteSection": "%event.message.web.webPageDetails.siteSection%",
                  "URL": "%event.message.web.webPageDetails.URL%"
                }
              },
              "_experience": {
                "analytics": {
                  "customDimensions": {
                    "eVars": {
                      "eVar9": "%event.message.pageType%",
                      "eVar10": "%event.message.event%",
                      "eVar11": "%event.message.user.loginStatus%",
                      "eVar12": "%event.message.user.profile.customerId%",
                      "eVar13": "%event.message.user.profile.memberTier%"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
