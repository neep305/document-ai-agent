{
  "property_info": {
    "name": "Auto-Generated WebSDK Property",
    "platform": "web"
  },
  "extensions": [
    {
      "name": "core",
      "package_name": "core"
    },
    {
      "name": "adobe-alchemy",
      "package_name": "adobe-alchemy",
      "settings": {
        "edgeConfigId": "REPLACE_WITH_DATASTREAM_ID"
      }
    }
  ],
  "rules": [
    {
      "name": "Click - Add to Cart",
      "notes": "Generated from HTML data-aa-event='add_to_cart'",
      "events": [
        {
          "delegate_id": "adobe-launch-extension-core:event-click",
          "extension_name": "core",
          "settings": {
            "elementSelector": "button.btn-add-to-cart[data-aa-event='add_to_cart']",
            "bubble": true
          }
        }
      ],
      "actions": [
        {
          "delegate_id": "adobe-alchemy:action-send-event",
          "extension_name": "adobe-alchemy",
          "settings": {
            "xdm": {
              "eventType": "commerce.productListAdds",
              "commerce": {
                "productListAdds": {
                  "value": 1
                },
                "order": {
                  "currencyCode": "%this.getAttribute('data-aa-currency')%"
                }
              },
              "_experience": {
                "analytics": {
                  "customDimensions": {
                    "eVars": {
                      "eVar10": "%this.getAttribute('data-aa-event')%"
                    }
                  }
                }
              },
              "productListItems": [
                {
                  "SKU": "%this.getAttribute('data-aa-product-id')%",
                  "name": "%this.getAttribute('data-aa-product-name')%",
                  "priceTotal": "%this.getAttribute('data-aa-price')%",
                  "quantity": 1,
                  "productCategories": [
                    {
                      "categoryID": "%this.getAttribute('data-aa-category')%"
                    }
                  ],
                  "_experience": {
                    "analytics": {
                      "customDimensions": {
                        "eVars": {
                          "eVar20": "%this.getAttribute('data-aa-product-id')%",
                          "eVar21": "%this.getAttribute('data-aa-product-name')%",
                          "eVar22": "%this.getAttribute('data-aa-category')%",
                          "eVar23": "%this.getAttribute('data-aa-brand')%"
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
